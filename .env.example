# ─────────────────────────────────────────────────────────────────────────────
# 96 Kapital CRM — environment manifest
#
# This is the recovery document for this project's configuration. The code is in
# GitHub; the VALUES live only in Vercel, and several are stored there as Secret
# type, which means they cannot be read back — `vercel env pull` returns
# [SENSITIVE]. If the Vercel project were ever lost, this file is what tells you
# what to re-create and where each one comes from.
#
# NEVER put real values in here. This repository is PUBLIC. Set values in Vercel
# (Production), then redeploy — env changes do not reach a running deployment.
#
# Every variable below is one the code actually reads. Keep it that way.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────

# Neon Postgres. console.neon.tech → project → Connection string (pooled).
# Always retrievable from Neon, so this one is never truly lost.
# Watch for a trailing newline when pasting — one lived here for 154 days.
DATABASE_URL=

# ── Dashboard auth ───────────────────────────────────────────────────────────

# Signs the session cookie. An arbitrary secret you choose: `openssl rand -hex 32`.
# Changing it immediately logs out every dashboard session. If it is missing the
# app fails closed — logins appear to succeed then bounce back to /login.
AUTH_SECRET=

# The single dashboard login. ADMIN_PASSWORD is compared directly.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── External API access ──────────────────────────────────────────────────────

# Authenticates POST /api/leads for the sites that post leads in — KAPVOY
# (kapvoy.sg) and the Indian Life Memorial site. An arbitrary secret you choose:
# `openssl rand -hex 32`.
#
# NOTE: there is deliberately NO NEXT_PUBLIC_ version of this. There used to be,
# and because NEXT_PUBLIC_ values are compiled into the client bundle, this key
# was served to every visitor's browser. The dashboard now authenticates with
# its own session cookie instead. Do not reintroduce it.
CRM_API_KEY=

# Set during a key rotation so both old and new keys are accepted, then cleared.
# Lets you rotate without a flash of downtime for the sites posting leads.
CRM_API_KEY_PREVIOUS=

# Extra browser origins allowed to call the API, comma-separated. The built-in
# list already covers the 96kapital domains and localhost.
CORS_ORIGINS=

# Absolute URL of this CRM, used to build the copy-paste integration snippets
# on the settings page. e.g. https://www.96kapital.com
NEXT_PUBLIC_CRM_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────

# resend.com → API Keys → create. Cannot be read back; if lost, revoke and reissue.
RESEND_API_KEY=

# The From address. MUST be on a domain verified at resend.com/domains.
# Leaving this unset is NOT harmless: the code falls back to Resend's shared test
# sender, which only delivers to the Resend account owner. Your own notifications
# arrive while every customer confirmation is rejected 403 — so it looks healthy
# and silently drops customer mail. This happened in production.
RESEND_FROM=

# Where the business lead notification goes. Not used for source 'fundwise',
# which already gets its own notification from the KAPVOY site.
BUSINESS_EMAIL=

# Optional branding in the email templates.
LOGO_URL=
WHATSAPP_NUMBER=

# ── WhatsApp (Green API) ─────────────────────────────────────────────────────

# console.green-api.com → your instance. All three are required together;
# if any is missing the WhatsApp notification is skipped and says so in the log.
GREEN_API_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Recipients of the new-lead WhatsApp, digits only with country code
# (e.g. 6596875688). _1 is required for notifications to send at all; _2 optional.
WA_NOTIFY_PHONE_1=
WA_NOTIFY_PHONE_2=

# ── AI insights ──────────────────────────────────────────────────────────────

# console.anthropic.com → API keys. Optional — without it the AI insights page
# reports 503 and says the key is not configured.
ANTHROPIC_API_KEY=
